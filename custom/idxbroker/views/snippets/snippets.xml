<?xml version="1.0" encoding="UTF-8"?>
<harpiya>
    <template id="snippets" inherit_id="website.snippets" name="estate snippets">
        <xpath expr="//t[@id='installed_snippets_hook']" position="after">
            <t snippet-group="estate" t-snippet="website.s_snippet_group" string="IDX Broker"
                t-thumbnail="/website/static/src/img/snippets_thumbs/s_dynamic_products.svg" />
        </xpath>
        <xpath expr="//t[@id='real_estate_hook']" position="replace">
            <t t-snippet="idxbroker.s_dynamic_snippet_estate" string="Estate"
                group="estate" />
        </xpath>
    </template>
</harpiya>