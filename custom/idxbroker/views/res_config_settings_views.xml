<?xml version="1.0" encoding="utf-8"?>
<harpiya>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_settings']" position="before">
            <block title="IDX Broker Settings" id="idxbroker_settings" groups="base.group_no_one">
            <setting id="idxbroker_app_setting" groups="base.group_no_one">
                    <label for="idxbroker_accesskey" string="IDX Broker"/>
                    <span class="fa fa-lg fa-globe" title="Values set here are website-specific." groups="website.group_multi_website"/>
                    <div class="text-muted">
                        Name of your website's IDX Broker Web Application
                    </div>
                    <div class="content-group">
                        <div class="row mt16">
                            <label class="col-lg-3 o_light_label" string="Access Key" for="idxbroker_accesskey"/>
                            <field name="idxbroker_accesskey" required="website_id"/>
                        </div>
                        <div class="row mt16">
                            <label class="col-lg-3 o_light_label" string="Developer Key" for="idxbroker_developer_key"/>
                            <field name="idxbroker_developer_key" required="website_id"/>
                        </div>
                    </div>
                </setting>
            </block>
                
            </xpath>
        </field>
    </record>
</harpiya>
